      "parameters": {
        "jsCode": "const data = $input.first().json;\n\nreturn [{\n  json: {\n    ok: false,\n    status: data.status || \"validation_error\",\n    message: data.message || \"The consultation details could not be validated.\"\n  }\n}];"
