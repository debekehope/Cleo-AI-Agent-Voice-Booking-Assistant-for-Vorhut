    {
      "parameters": {
        "jsCode": "const booking = $('Is Booking Already Confirmed?').item.json;\nconst originalBooking = $input.first().json;\n\nconst createdAt = originalBooking.created_at;\n\nif (!createdAt) {\n  throw new Error('Original booking created_at timestamp was not returned.');\n}\n\nconst createdAtLagos = new Date(createdAt).toLocaleString('en-GB', {\n  timeZone: 'Africa/Lagos',\n  dateStyle: 'long',\n  timeStyle: 'short'\n});\n\nconst appointmentDate = new Date(booking.start_time).toLocaleString('en-GB', {\n  timeZone: 'Africa/Lagos',\n  dateStyle: 'long',\n  timeStyle: 'short'\n});\n\nconst message =\n  `Your personal styling consultation is already booked for ${appointmentDate} Lagos time. ` +\n  `The original booking was registered on ${createdAtLagos} Lagos time. ` +\n  `Please check your inbox around that date and time for the original confirmation email. ` +\n  `No duplicate appointment was created.`;\n\nreturn [\n  {\n    json: {\n      status: 'already_booked',\n      message: message,\n      bookingId: booking.booking_id,\n      customerName: booking.customer_name,\n      email: booking.customer_email,\n      consultationType: booking.consultation_type,\n      clothingNeeds: booking.clothing_needs,\n      startTime: booking.start_time,\n      endTime: booking.end_time,\n      originalBookingCreatedAt: createdAt\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1936,
        656
      ],
      "id": "9ff083d2-d8ae-4335-bbd0-f5ceec0ef779",
      "name": "Return Existing Booking"
    },
    {
      "parameters": {
        "jsCode": "const booking = $input.first().json;\n\nconst messages = {\n  still_processing: \"Your booking request is still being processed. Please wait a moment before trying again.\",\n  previous_failed: \"Your previous booking attempt was unsuccessful. Please choose a time so we can try again.\",\n  slot_unavailable: \"That appointment time is unavailable. Please choose another time.\"\n};\n\nreturn [{\n  json: {\n    ok: false,\n    status: booking.outcome,\n    message: messages[booking.outcome] ||\n      \"We couldn't confirm this booking. Please try another time or contact VORHUT.\"\n  }\n}];"
      },
