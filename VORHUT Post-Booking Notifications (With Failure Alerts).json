{
  "name": "VORHUT Post-Booking Notifications (With Failure Alerts)",
  "nodes": [
    {
      "parameters": {
        "content": " This workflow sends the customer confirmation email, appends the booking to Google Sheets, and sends the owner a Telegram booking notification. These three notifications run as separate branches. If Gmail, Google Sheets, or the Telegram booking notification fails, the corresponding error output sends a failure alert to slack",
